{"id":12062,"name":"\u0635\u0646\u062f\u0644\u06cc  \u0627\u06cc\u06a9\u06cc\u0627 RAVAROR","slug":"%d8%b5%d9%86%d8%af%d9%84%db%8c-ravaror-%d8%a7%db%8c%da%a9%db%8c%d8%a7","permalink":"https:\/\/zardaan.com\/product\/%d8%b5%d9%86%d8%af%d9%84%db%8c-ravaror-%d8%a7%db%8c%da%a9%db%8c%d8%a7\/","date_created":"2022-02-17T15:12:47","date_created_gmt":"2022-02-17T11:42:47","date_modified":"2026-06-07T11:22:32","date_modified_gmt":"2026-06-07T07:52:32","type":"simple","status":"publish","featured":false,"catalog_visibility":"visible","description":"\u0635\u0646\u062f\u0644\u06cc \u0627\u06cc\u06a9\u06cc\u0627 R\u00c5VAROR \u0628\u0627 \u0648\u062c\u0648\u062f \u067e\u0634\u062a\u06cc \u0648 \u0635\u0646\u062f\u0644\u06cc \u062d\u0627\u0644\u062a \u062f\u0627\u0631 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0631\u0648\u06cc \u0627\u06cc\u0646 \u0635\u0646\u062f\u0644\u06cc <strong>\u0627\u06cc\u06a9\u06cc\u0627<\/strong> \u0645\u06cc\u0646\u0634\u06cc\u0646\u06cc\u062f.\r\n\u0634\u0645\u0627 \u0645\u06cc\u062a\u0648\u0627\u0646\u06cc\u062f \u0635\u0646\u062f\u0644\u06cc \u0627\u06cc\u06a9\u06cc\u0627 \u0631\u0627 \u062a\u0627 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u0648\u0642\u062a\u06cc \u0628\u0647 \u0622\u0646 \u0646\u06cc\u0627\u0632\u06cc \u0646\u062f\u0627\u0631\u06cc\u062f \u0641\u0636\u0627\u06cc \u0632\u06cc\u0627\u062f\u06cc \u0627\u0634\u063a\u0627\u0644 \u0646\u06a9\u0646\u062f \u0647\u0645\u0686\u0646\u06cc\u0646 \u062f\u0631 \u0635\u0648\u0631\u062a \u0646\u06cc\u0627\u0632 \u0645\u06cc\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u0622\u0646 \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0631\u062f\u0647 \u0648 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.\r\n\u0634\u0627\u06cc\u062f \u0628\u062f \u0646\u0628\u0627\u0634\u062f \u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0633\u0627\u06cc\u06cc\u062f\u06af\u06cc \u06a9\u0641 \u060c \u0627\u0632 \u0645\u062d\u0627\u0641\u0638 FIXA \u0632\u06cc\u0631 \u067e\u0627\u06cc\u0647 \u0647\u0627\u06cc \u0627\u06cc\u0646 \u0635\u0646\u062f\u0644\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.\r\n\u062f\u0648\u0627\u0645 \u0648 \u0627\u0645\u0646\u06cc\u062a \u0627\u06cc\u0646 \u0635\u0646\u062f\u0644\u06cc \u0628\u0631\u0627\u06cc \u0645\u0635\u0627\u0631\u0641 \u062e\u0627\u0646\u06af\u06cc \u062a\u0633\u062a \u0634\u062f\u0647 \u0648 \u0627\u0644\u0632\u0627\u0645\u0627\u062a \u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u062f\u0647\u0627\u06cc EN 12520 \u0648 EN 12520 \u0631\u0627 \u067e\u0627\u0633 \u0645\u06cc\u06a9\u0646\u062f.\r\n<h5><strong>\u0686\u0648\u0628 \u062c\u0627\u0645\u062f \u0686\u06cc\u0633\u062a\u061f<\/strong><\/h5>\r\n\u0686\u0648\u0628 \u062c\u0627\u0645\u062f \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u0648\u0627\u062f \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647 \u0645\u0627 \u0627\u0633\u062a \u0648 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0645\u06cc\u0631\u0627\u062b \u0627\u0633\u06a9\u0627\u0646\u062f\u06cc\u0646\u0627\u0648\u06cc \u0645\u0627 \u0627\u0633\u062a. \u0647\u0645\u0686\u0646\u06cc\u0646 \u06cc\u06a9 \u0645\u0627\u062f\u0647 \u062c\u0627\u0648\u062f\u0627\u0646\u0647 \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u062f\u0647\u0627\u06cc \u0641\u0631\u0627\u0648\u0627\u0646 \u0627\u0633\u062a.\r\n\r\n\u0635\u0631\u0641 \u0646\u0638\u0631 \u0627\u0632 \u0646\u0648\u0639 \u0686\u0648\u0628\u060c \u0628\u0627\u062f\u0648\u0627\u0645\u060c \u0632\u06cc\u0628\u0627\u060c \u062a\u062c\u062f\u06cc\u062f \u067e\u0630\u06cc\u0631 \u0648 \u0642\u0627\u0628\u0644 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u0627\u0633\u062a. \u0645\u0627 \u062f\u0631 \u062a\u0644\u0627\u0634 \u0647\u0633\u062a\u06cc\u0645 \u062a\u0627 \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0627\u062f\u0647 \u062e\u0627\u0645 \u062a\u0627 \u062d\u062f \u0627\u0645\u06a9\u0627\u0646 \u0647\u0648\u0634\u0645\u0646\u062f\u0627\u0646\u0647 \u0648 \u06a9\u0627\u0631\u0622\u0645\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0627\u0632 \u0627\u062a\u0644\u0627\u0641 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u06a9\u0646\u06cc\u0645\r\n\r\n\u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u062f\u0631 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0648 \u062a\u062f\u0627\u0631\u06a9\u0627\u062a \u0633\u0631\u0645\u0627\u06cc\u0647 \u06af\u0630\u0627\u0631\u06cc \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0628\u062a\u0648\u0627\u0646\u06cc\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0686\u0648\u0628 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a\u06cc \u0631\u0627 \u0627\u0641\u0632\u0627\u06cc\u0634 \u062f\u0647\u06cc\u0645. \u0628\u0647 \u0627\u06cc\u0646 \u062a\u0631\u062a\u06cc\u0628\u060c \u0627\u0632 \u0647\u0631 \u062f\u0631\u062e\u062a\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0642\u062f\u0627\u0631 \u0627\u0646\u062f\u06a9 \u0628\u0647 \u062e\u0648\u0628\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f\r\n\r\n\u062c\u0646\u06af\u0644 \u0647\u0627 \u0628\u0631\u0627\u06cc \u062d\u06cc\u0627\u062a \u0631\u0648\u06cc \u0632\u0645\u06cc\u0646 \u062d\u06cc\u0627\u062a\u06cc \u0647\u0633\u062a\u0646\u062f\r\n\r\n<span data-language-for-alternatives=\"fa\" data-language-to-translate-into=\"en\" data-phrase-index=\"2\" data-number-of-phrases=\"8\">\u062c\u0646\u06af\u0644 \u0647\u0627 \u0628\u0647 \u062d\u0641\u0638 \u062a\u0639\u0627\u062f\u0644 \u062f\u0631 \u062c\u0648 \u06a9\u0645\u06a9 \u0645\u06cc \u06a9\u0646\u0646\u062f\u060c \u0647\u0648\u0627\u06cc\u06cc \u06a9\u0647 \u062a\u0646\u0641\u0633 \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u0631\u0627 \u062a\u0635\u0641\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u0646\u062f \u0648 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0686\u0631\u062e\u0647 \u0622\u0628 \u0647\u0633\u062a\u0646\u062f.<\/span>\r\n\r\n\u0622\u0646\u0647\u0627 \u062a\u0646\u0648\u0639 \u0632\u06cc\u0633\u062a\u06cc \u062d\u06cc\u0627\u062a \u0648\u062d\u0634 \u0631\u0627 \u062a\u063a\u0630\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u0646\u062f \u0648 \u062e\u0627\u0646\u0647 \u0647\u0627\u06cc\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u062c\u0648\u0627\u0645\u0639 \u0628\u0648\u0645\u06cc \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc \u06a9\u0646\u0646\u062f \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0627\u0645\u0631\u0627\u0631 \u0645\u0639\u0627\u0634 \u062e\u0648\u062f \u0628\u0647 \u062c\u0646\u06af\u0644 \u0647\u0627 \u0648\u0627\u0628\u0633\u062a\u0647 \u0647\u0633\u062a\u0646\u062f.\r\n\r\n90 \u062f\u0631\u0635\u062f \u06af\u0648\u0646\u0647 \u0647\u0627\u06cc \u06af\u06cc\u0627\u0647\u06cc \u0648 \u062c\u0627\u0646\u0648\u0631\u06cc \u06a9\u0647 \u0631\u0648\u06cc \u06a9\u0631\u0647 \u0632\u0645\u06cc\u0646 \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc \u06a9\u0646\u0646\u062f \u0628\u0631\u0627\u06cc \u0628\u0642\u0627 \u0628\u0647 \u062c\u0646\u06af\u0644 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u0646\u062f. \u0622\u0646\u0647\u0627 \u0645\u0646\u0627\u0628\u0639 \u063a\u0630\u0627\u060c \u0633\u0648\u062e\u062a\u060c\r\n\r\n\u0627\u0644\u0648\u0627\u0631 \u0648 \u0628\u0633\u06cc\u0627\u0631\u06cc \u062f\u06cc\u06af\u0631 \u0627\u0632 \u062e\u062f\u0645\u0627\u062a \u0627\u06a9\u0648\u0633\u06cc\u0633\u062a\u0645\u06cc \u0631\u0627 \u06a9\u0647 \u0645\u0627 \u0628\u0647 \u0622\u0646\u0647\u0627 \u062a\u06a9\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u06cc\u0645\u060c \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc \u06a9\u0646\u0646\u062f.\r\n\r\nIKEA \u0628\u0627 \u062a\u0627\u0645\u06cc\u0646 \u062d\u062f\u0648\u062f 19 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0645\u062a\u0631\u0645\u06a9\u0639\u0628 \u0686\u0648\u0628 \u06af\u0631\u062f \u062f\u0631 \u0633\u0627\u0644 \u0627\u0632 50 \u06a9\u0634\u0648\u0631 \u062c\u0647\u0627\u0646\u060c \u062a\u0623\u062b\u06cc\u0631 \u0642\u0627\u0628\u0644 \u062a\u0648\u062c\u0647\u06cc \u0628\u0631 \u062c\u0646\u06af\u0644\u200c\u0647\u0627\u06cc \u062c\u0647\u0627\u0646 \u0648 \u0635\u0646\u0639\u062a \u0686\u0648\u0628 \u062f\u0627\u0631\u062f\r\n\r\n\u0648 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0628\u0632\u0631\u06af\u06cc \u0628\u0631\u0627\u06cc \u062a\u0623\u062b\u06cc\u0631 \u0645\u062b\u0628\u062a \u0628\u0631 \u0646\u062d\u0648\u0647 \u062a\u0647\u06cc\u0647 \u0686\u0648\u0628 \u062f\u0627\u0631\u062f. \u062a\u0627\u0645\u06cc\u0646 \u0645\u0646\u0627\u0628\u0639 \u0686\u0648\u0628 \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u062c\u0646\u06af\u0644 \u0645\u0633\u0626\u0648\u0644\u0627\u0646\u0647 \u062a\u0636\u0645\u06cc\u0646 \u0645\u06cc \u06a9\u0646\u062f \u06a9\u0647 \u0646\u06cc\u0627\u0632\u0647\u0627\u06cc \u0627\u0641\u0631\u0627\u062f \u0648\u0627\u0628\u0633\u062a\u0647 \u0628\u0647 \u062c\u0646\u06af\u0644 \u0628\u0631\u0622\u0648\u0631\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f\u060c\r\n\r\n\u06a9\u0633\u0628 \u0648 \u06a9\u0627\u0631\u0647\u0627 \u0645\u06cc \u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0647 \u0637\u0648\u0631 \u067e\u0627\u06cc\u062f\u0627\u0631 \u06a9\u0627\u0631 \u06a9\u0646\u0646\u062f\u060c \u0627\u06a9\u0648\u0633\u06cc\u0633\u062a\u0645 \u0647\u0627\u06cc \u062c\u0646\u06af\u0644\u06cc \u0645\u062d\u0627\u0641\u0638\u062a \u0645\u06cc \u0634\u0648\u0646\u062f \u0648 \u062a\u0646\u0648\u0639 \u0632\u06cc\u0633\u062a\u06cc \u0627\u0641\u0632\u0627\u06cc\u0634 \u0645\u06cc \u06cc\u0627\u0628\u062f.\r\n\r\n\u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u062f\u06cc\u06af\u0631 \u0635\u0646\u062f\u0644\u06cc \u0647\u0627\u00a0 \u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0627\u06cc\u06a9\u06cc\u0627 \u0628\u0631 \u0631\u0648\u06cc\u00a0 <a href=\"https:\/\/www.ikea.com\/ae\/en\/search\/products\/?q=Folding%20chair\">(AKEA)<\/a>\u00a0 \u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0632\u0631\u062f\u0627\u0646 \u0628\u0631 \u0631\u0648\u06cc (\u0632\u0631\u062f\u06