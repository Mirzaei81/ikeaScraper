{"code":"woocommerce_rest_invalid_product_id","message":"\u0628\u0631\u0627\u06cc \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0645\u062d\u0635\u0648\u0644 \u0634\u0645\u0627 \u0645\u06cc \u0628\u0627\u06cc\u0633\u062a \u0627\u0632 \u0646\u0642\u0637\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc \/products\/&lt;product_id&gt;\/variations\/&lt;id&gt; \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.","data":{"status":404}}
{"code":"woocommerce_rest_invalid_product_id","message":"\u0628\u0631\u0627\u06cc \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0645\u062d\u0635\u0648\u0644 \u0634\u0645\u0627 \u0645\u06cc \u0628\u0627\u06cc\u0633\u062a \u0627\u0632 \u0646\u0642\u0637\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc \/products\/&lt;product_id&gt;\/variations\/&lt;id&gt; \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.","data":{"status":404}}
{"code":"woocommerce_rest_invalid_product_id","message":"\u0628\u0631\u0627\u06cc \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0645\u062d\u0635\u0648\u0644 \u0634\u0645\u0627 \u0645\u06cc \u0628\u0627\u06cc\u0633\u062a \u0627\u0632 \u0646\u0642\u0637\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc \/products\/&lt;product_id&gt;\/variations\/&lt;id&gt; \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.","data":{"status":404}}
{"code":"woocommerce_rest_invalid_product_id","message":"\u0628\u0631\u0627\u06cc \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0645\u062d\u0635\u0648\u0644 \u0634\u0645\u0627 \u0645\u06cc \u0628\u0627\u06cc\u0633\u062a \u0627\u0632 \u0646\u0642\u0637\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc \/products\/&lt;product_id&gt;\/variations\/&lt;id&gt; \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.","data":{"status":404}}
{"id":9854,"name":"\u06a9\u0627\u0646\u0627\u067e\u0647 \u062a\u062e\u062a \u062e\u0648\u0627\u0628 \u0634\u0648 \u0627\u06cc\u06a9\u06cc\u0627 HEMNES","slug":"%da%a9%d8%a7%d9%86%d8%a7%d9%be%d9%87-%d8%aa%d8%ae%d8%aa-%d8%ae%d9%88%d8%a7%d8%a8-%d8%b4%d9%88-%d9%82%d9%87%d9%88%d9%87-%d8%a7%db%8c-hemnes-%d8%a7%db%8c%da%a9%db%8c%d8%a7","permalink":"https:\/\/zardaan.com\/product\/%da%a9%d8%a7%d9%86%d8%a7%d9%be%d9%87-%d8%aa%d8%ae%d8%aa-%d8%ae%d9%88%d8%a7%d8%a8-%d8%b4%d9%88-%d9%82%d9%87%d9%88%d9%87-%d8%a7%db%8c-hemnes-%d8%a7%db%8c%da%a9%db%8c%d8%a7\/","date_created":"2022-01-24T17:55:35","date_created_gmt":"2022-01-24T14:25:35","date_modified":"2026-05-20T19:25:27","date_modified_gmt":"2026-05-20T15:55:27","type":"simple","status":"publish","featured":false,"catalog_visibility":"visible","description":"<h2>\u06a9\u0627\u0646\u0627\u067e\u0647 \u062a\u062e\u062a \u062e\u0648\u0627\u0628 \u0634\u0648 \u0627\u06cc\u06a9\u06cc\u0627 HEMNES<\/h2>\r\n\u06a9\u0627\u0646\u0627\u067e\u0647 \u062a\u062e\u062a \u062e\u0648\u0627\u0628 \u0634\u0648 \u0627\u06cc\u06a9\u06cc\u0627 HEMNES\u00a0 \u0628\u0627 \u062a\u062e\u062a \u062e\u0648\u0627\u0628 \u0627\u06cc\u06a9\u06cc\u0627 \u0634\u0645\u0627 \u0628\u0647 \u0633\u0631\u0639\u062a \u0648 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0645\u06cc\u062a\u0648\u0627\u0646\u06cc\u062f \u0641\u0636\u0627\u06cc\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0631\u0627\u062d\u062a \u0634\u0628\u0627\u0646\u0647 \u062e\u0648\u062f \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f. \u0641\u0642\u0637 \u067e\u0627\u06cc\u0647 \u062a\u062e\u062a \u0631\u0627 \u0628\u06cc\u0631\u0648\u0646 \u0628\u06a9\u0634\u06cc\u062f \u0648 \u062f\u0631 \u06a9\u0645\u062a\u0631\u06cc\u0646 \u0632\u0645\u0627\u0646 \u0622\u0646 \u0631\u0627 \u0628\u0647 \u06cc\u06a9 \u062a\u062e\u062a \u062f\u0648\u0646\u0641\u0631\u0647 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0646\u06cc\u062f.\r\n\r\n\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0686\u0646\u062f \u0628\u0627\u0644\u0634 \u0646\u0631\u0645 \u0648 \u06a9\u0631\u06a9\u06cc \u062f\u0631 \u067e\u0634\u062a \u062e\u0648\u062f\u060c \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u06cc\u0646 \u062a\u062e\u062a \u062e\u0648\u0627\u0628 \u0631\u0627 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0628\u0647 \u06cc\u06a9 \u06a9\u0627\u0646\u0627\u067e\u0647 \u0631\u0627\u062d\u062a\u06cc \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0646\u06cc\u062f.\r\n\r\n\u06a9\u0634\u0648\u0647\u0627\u06cc \u0628\u0632\u0631\u06af \u062f\u0627\u0631\u0627\u06cc \u0641\u0636\u0627\u06cc\u06cc \u0639\u0627\u0644\u06cc \u0628\u0631\u0627\u06cc \u0644\u062d\u0627\u0641\u060c \u0628\u0627\u0644\u0634\u060c \u0645\u0644\u062d\u0641\u0647 \u06cc\u0627 \u0686\u06cc\u0632\u0647\u0627\u06cc \u062f\u06cc\u06af\u0631\u06cc \u0647\u0633\u062a\u0646\u062f \u06a9\u0647 \u0644\u0627\u0632 \u062f\u0627\u0631\u06cc\u062f \u062f\u0631 \u0622\u0646 \u0646\u06a9\u0647 \u062f\u0627\u0631\u06cc\u062f \u0627\u0645\u0627 \u062f\u0631 \u0639\u06cc\u0646 \u062d\u0627\u0644 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0634\u0645\u0627 \u0628\u0627\u0634\u0646\u062f.\r\n\r\n\u062f\u06cc\u0648\u0627\u0631\u0647 \u0628\u0644\u0646\u062f \u062d\u0633 \u062f\u0644\u067e\u0630\u06cc\u0631\u06cc \u0634\u0628\u06cc\u0647 \u0628\u0647 \u067e\u06cc\u0644\u0647 \u0628\u0647 \u0634\u0645\u0627 \u0645\u06cc\u062f\u0647\u062f \u0648 \u062f\u0631 \u0639\u06cc\u0646 \u062d\u0627\u0644 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u0627\u06cc\u0646\u06a9\u0647 \u0644\u0627\u06a9\u06cc \u0634\u062f\u0647 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0622\u0646 \u0622\u0633\u0627\u0646\u062a\u0631 \u0627\u0633\u062a.\r\n\r\n\u062a\u062e\u062a \u062e\u0648\u0627\u0628 \u0628\u0627\u06cc\u062f \u0628\u0627 \u062f\u0648 \u062a\u0634\u06a9 80x200 \u067e\u0648\u0634\u0627\u0646\u062f\u0647 \u0634\u0648\u062f. \u0648\u0642\u062a\u06cc \u0627\u0632 \u062a\u062e\u062a \u062e\u0648\u0627\u0628 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u062a\u062e\u062a \u06cc\u06a9 \u0646\u0641\u0631\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u06a9\u0646\u06cc\u062f \u062a\u0634\u06a9\u0647\u0627 \u0631\u0648\u06cc \u0647\u0645 \u0642\u0631\u0627\u0631 \u0645\u06cc \u06af\u06cc\u0631\u0646\u062f \u0648 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0627\u0632 \u0622\u0646 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u062a\u062e\u062a \u062f\u0648\u0646\u0641\u0631\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u06a9\u0646\u06cc\u062f \u062f\u0631 \u06a9\u0646\u0627\u0631 \u0647\u0645 \u0642\u0631\u0627\u0631 \u0645\u06cc \u06af\u06cc\u0631\u0646\u062f.\r\n\r\n\u0628\u0627 \u0633\u0627\u06cc\u0631 \u0645\u0628\u0644\u0645\u0627\u0646 \u0633\u0631\u06cc HEMNES \u0627\u06cc\u06a9\u06cc\u0627 \u062a\u0631\u06a9\u06cc\u0628 \u0645\u06cc \u0634\u0648\u062f.\r\n\r\n\u062a\u0634\u06a9 \u0648 \u0645\u0644\u062d\u0641\u0647 \u0628\u0647 \u0635\u0648\u0631\u062a \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0641\u0631\u0648\u062e\u062a\u0647 \u0645\u06cc \u0634\u0648\u062f.\r\n\r\n\u0642\u06cc\u0645\u062a \u0645\u062d\u0635\u0648\u0644 \u0634\u0627\u0645\u0644 \u062a\u062e\u062a\u0647 \u0686\u0648\u0628\u06cc \u0632\u06cc\u0631 \u062a\u0634\u06a9 \u0646\u06cc\u0632 \u0645\u06cc\u0634\u0648\u062f.\r\n\r\n<strong>\u0686\u0648\u0628 \u062c\u0627\u0645\u062f \u0686\u06cc\u0633\u062a\u061f<\/strong>\r\n\r\n\u0686\u0648\u0628 \u062c\u0627\u0645\u062f \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u0648\u0627\u062f \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647 \u0645\u0627 \u0627\u0633\u062a \u0648 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0645\u06cc\u0631\u0627\u062b \u0627\u0633\u06a9\u0627\u0646\u062f\u06cc\u0646\u0627\u0648\u06cc \u0645\u0627 \u0627\u0633\u062a. \u0647\u0645\u0686\u0646\u06cc\u0646 \u06cc\u06a9 \u0645\u0627\u062f\u0647 \u062c\u0627\u0648\u062f\u0627\u0646\u0647 \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u062f\u0647\u0627\u06cc \u0641\u0631\u0627\u0648\u0627\u0646 \u0627\u0633\u062a.\r\n\r\n\u0635\u0631\u0641 \u0646\u0638\u0631 \u0627\u0632 \u0646\u0648\u0639 \u0686\u0648\u0628\u060c \u0628\u0627\u062f\u0648\u0627\u0645\u060c \u0632\u06cc\u0628\u0627\u060c \u062a\u062c\u062f\u06cc\u062f \u067e\u0630\u06cc\u0631 \u0648 \u0642\u0627\u0628\u0644 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u0627\u0633\u062a. \u0645\u0627 \u062f\u0631 \u062a\u0644\u0627\u0634 \u0647\u0633\u062a\u06cc\u0645 \u062a\u0627 \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0627\u062f\u0647 \u062e\u0627\u0645 \u062a\u0627 \u062d\u062f \u0627\u0645\u06a9\u0627\u0646 \u0647\u0648\u0634\u0645\u0646\u062f\u0627\u0646\u0647 \u0648 \u06a9\u0627\u0631\u0622\u0645\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0627\u0632 \u0627\u062a\u0644\u0627\u0641 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u06a9\u0646\u06cc\u0645\r\n\r\n\u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u062f\u0631 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0648 \u062a\u062f\u0627\u0631\u06a9\u0627\u062a \u0633\u0631\u0645\u0627\u06cc\u0647 \u06af\u0630\u0627\u0631\u06cc \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0628\u062a\u0648\u0627\u0646\u06cc\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0686\u0648\u0628 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a\u06cc \u0631\u0627 \u0627\u0641\u0632\u0627\u06cc\u0634 \u062f\u0647\u06cc\u0645. \u0628\u0647 \u0627\u06cc\u0646 \u062a\u0631\u062a\u06cc\u0628\u060c \u0627\u0632 \u0647\u0631 \u062f\u0631\u062e\u062a\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0642\u062f\u0627\u0631 \u0627\u0646\u062f\u06a9 \u0628\u0647 \u062e\u0648\u0628\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f\r\n<h3>\u062c\u0646\u06af\u0644 \u0647\u0627 \u0628\u0631\u0627\u06cc \u062d\u06cc\u0627\u062a \u0631\u0648\u06cc \u0632\u0645\u06cc\u0646 \u062d\u06cc\u0627\u062a\u06cc \u0647\u0633\u062a\u0646\u062f<\/h3>\r\n\u062c\u0646\u06af\u0644 \u0647\u0627 \u0628\u0647 \u062d\u0641\u0638 \u062a\u0639\u0627\u062f\u0644 \u062f\u0631 \u062c\u0648 \u06a9\u0645\u06a9 \u0645\u06cc \u06a9\u0646\u0646\u062f\u060c \u0647\u0648\u0627\u06cc\u06cc \u06a9\u0647 \u062a\u0646\u0641\u0633 \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u0631\u0627 \u062a\u0635\u0641\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u0646\u062f \u0648 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0686\u0631\u062e\u0647 \u0622\u0628 \u0647\u0633\u062a\u0646\u062f.\r\n\r\n90 \u062f\u0631\u0635\u062f \u06af\u0648\u0646\u0647 \u0647\u0627\u06cc \u06af\u06cc\u0627\u0647\u06cc \u0648 \u062c\u0627\u0646\u0648\u0631\u06cc \u06a9\u0647 \u0631\u0648\u06cc \u06a9\u0631\u0647 \u0632\u0645\u06cc\u0646 \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc \u06a9\u0646\u0646\u062f \u0628\u0631\u0627\u06cc \u0628\u0642\u0627 \u0628\u0647 \u062c\u0646\u06af\u0644 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u0646\u062f.\r\n\r\n\u0622\u0646\u0647\u0627 \u0645\u0646\u0627\u0628\u0639 \u063a\u0630\u0627\u060c \u0633\u0648\u062e\u062a\u060c \u0627\u0644\u0648\u0627\u0631 \u0648 \u0628\u0633\u06cc\u0627\u0631\u06cc \u062f\u06cc\u06af\u0631 \u0627\u0632 \u062e\u062f\u0645\u0627\u062a \u0627\u06a9\u0648\u0633\u06cc\u0633\u062a\u0645\u06cc \u0631\u0627 \u06a9\u0647 \u0645\u0627 \u0628\u0647 \u0622\u0646\u0647\u0627 \u062a\u06a9\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u06cc\u0645\u060c \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc \u06a9\u0646\u0646\u062f.\r\n\r\nIKEA \u0628\u0627 \u062a\u0623\u0645\u06cc\u0646 \u062d\u062f\u0648\u062f 19 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0645\u062a\u0631\u0645\u06a9\u0639\u0628 \u0686\u0648\u0628 \u06af\u0631\u062f \u062f\u0631 \u0633\u0627\u0644 \u0627\u0632 50 \u06a9\u0634\u0648\u0631 \u062c\u0647\u0627\u0646\u060c \u062a\u0623\u062b\u06cc\u0631 \u0642\u0627\u0628\u0644 \u062a\u0648\u062c\u0647\u06cc \u0628\u0631 \u062c\u0646\u06af\u0644\u200c\u0647\u0627\u06cc \u062c\u0647\u0627\u0646 \u0648 \u0635\u0646\u0639\u062a \u0686\u0648\u0628 \u062f\u0627\u0631\u062f \u0648\r\n\r\n\u0645\u063