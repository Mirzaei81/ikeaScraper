{"id":11385,"name":"\u0645\u06cc\u0632 \u06af\u0631\u062f \u0627\u06cc\u06a9\u06cc\u0627 GAMLARED","slug":"%d9%85%db%8c%d8%b2-%da%af%d8%b1%d8%af-%d8%a7%db%8c%da%a9%db%8c%d8%a7-gamlared","permalink":"https:\/\/zardaan.com\/product\/%d9%85%db%8c%d8%b2-%da%af%d8%b1%d8%af-%d8%a7%db%8c%da%a9%db%8c%d8%a7-gamlared\/","date_created":"2022-02-08T17:18:01","date_created_gmt":"2022-02-08T13:48:01","date_modified":"2026-06-07T11:19:29","date_modified_gmt":"2026-06-07T07:49:29","type":"simple","status":"publish","featured":false,"catalog_visibility":"visible","description":"<h4>\u0645\u06cc\u0632 \u06af\u0631\u062f \u0627\u06cc\u06a9\u06cc\u0627 GAMLARED<\/h4>\r\n\u0645\u06cc\u0632 \u06af\u0631\u062f \u0627\u06cc\u06a9\u06cc\u0627 GAMLARED\u00a0 \u0645\u06cc\u0632 \u06af\u0631\u062f<strong> \u0627\u06cc\u06a9\u06cc\u0627<\/strong> \u0645\u06cc\u0632 \u0645\u0646\u0627\u0633\u0628\u06cc \u0628\u0631\u0627\u06cc \u062f\u0648\u0631\u0647\u0645\u06cc \u0648 \u0645\u0639\u0627\u0634\u0631\u062a \u0628\u0648\u062f\u0647 \u00a0\u0648 \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u06af\u0641\u062a\u06af\u0648\u06cc\u06cc \u0622\u0631\u0627\u0645 \u062f\u0639\u0648\u062a \u0645\u06cc \u06a9\u0646\u062f.\r\n\r\n\u062d\u0633 \u06af\u0631\u0645\u0627\u06cc \u0686\u0648\u0628 \u0628\u0627 \u0644\u0628\u0647 \u0647\u0627\u06cc \u0646\u0631\u0645 \u0648 \u0645\u0646\u062d\u0646\u06cc \u0641\u0636\u0627\u06cc\u06cc \u062f\u0646\u062c \u0648 \u0622\u0631\u0627\u0645 \u0631\u0627 \u0627\u06cc\u062c\u0627\u062f \u0645\u06cc \u06a9\u0646\u062f \u0648 \u00a0\u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u062f\u0631 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u062e\u0627\u0646\u0647 \u0642\u0631\u0627\u0631 \u0645\u06cc \u06af\u06cc\u0631\u062f.\r\n\r\n\u0627\u0628\u0639\u0627\u062f \u06a9\u0648\u0686\u06a9 \u0627\u06cc\u0646 \u0645\u06cc\u0632 \u0628\u0627\u0639\u062b \u0645\u06cc\u0634\u0648\u062f \u062d\u062a\u06cc \u062f\u0631 \u0641\u0636\u0627\u0647\u0627\u06cc \u0628\u0633\u06cc\u0627\u0631 \u0645\u062d\u062f\u0648\u062f \u0642\u0627\u0628\u0644 \u0646\u0635\u0628 \u0648 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0628\u0627\u0634\u062f.\r\n\r\n\u0645\u06cc\u0632 \u06af\u0631\u062f \u0628\u0627 \u0644\u0628\u0647 \u0647\u0627\u06cc \u0646\u0631\u0645 \u062d\u0633 \u06af\u0631\u0645\u0627\u06cc\u06cc \u062e\u0627\u0635\u06cc \u0628\u0647 \u0627\u062a\u0627\u0642 \u0646\u0634\u06cc\u0645\u0646 \u0634\u0645\u0627 \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f. \u0686\u0648\u0628 \u06a9\u0627\u062c \u0628\u0627 \u06af\u0630\u0634\u062a \u0632\u0645\u0627\u0646 \u0638\u0627\u0647\u0631 \u0648 \u0648\u06cc\u0698\u06af\u06cc \u0645\u0646\u062d\u0635\u0631 \u0628\u0647 \u0641\u0631\u062f \u062e\u0648\u062f \u0631\u0627 \u0628\u062f\u0633\u062a \u0645\u06cc \u0622\u0648\u0631\u062f.\r\n\r\n\u0686\u0648\u0628 \u0628\u0627\u062f\u0648\u0627\u0645 \u0631\u0646\u06af \u0634\u062f\u0647 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0637\u0648\u0644\u0627\u0646\u06cc \u0645\u062f\u062a \u06af\u0632\u06cc\u0646\u0647 \u0628\u0633\u06cc\u0627\u0631 \u0645\u0646\u0627\u0633\u0628\u06cc \u0645\u06cc\u0628\u0627\u0634\u062f.\r\n\r\n\u0645\u0627 \u0627\u06cc\u0646 \u0645\u062d\u0635\u0648\u0644 <strong>\u0627\u06cc\u06a9\u06cc\u0627<\/strong> \u0631\u0627 \u0628\u0631\u0627\u06cc\u062a\u0627\u0646 \u062a\u0633\u062a \u06a9\u0631\u062f\u0647 \u0627\u06cc\u0645 \u0648\u0628\u0647 \u0634\u0645\u0627 \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u0645\u06cc\u062f\u0647\u06cc\u0645 \u06a9\u0647 \u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u0633\u0627\u062e\u062a\u0627\u0631\u06cc \u0628\u0627 \u062f\u0648\u0627\u0645 \u0633\u0637\u062d \u0622\u0646 \u0646\u06cc\u0632 \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u0645\u0627\u06cc\u0639\u0627\u062a\u060c \u0644\u06a9\u0647 \u0647\u0627\u06cc \u063a\u0630\u0627\u060c \u0631\u0648\u063a\u0646\u060c \u062d\u0631\u0627\u0631\u062a\u060c \u062e\u0637 \u0648 \u062e\u0634 \u0648 \u0636\u0631\u0628\u0647 \u0645\u0642\u0627\u0648\u0645 \u0627\u0633\u062a \u062f\u0631 \u0646\u062a\u06cc\u062c\u0647 \u06af\u0632\u06cc\u0646\u0647 \u0628\u0633\u06cc\u0627\u0631 \u0645\u0646\u0627\u0633\u0628\u06cc \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u062f\u0627\u0648\u0645 \u0648 \u0631\u0648\u0632\u0627\u0646\u0647 \u0645\u06cc\u0628\u0627\u0634\u062f.\r\n\r\n\u062a\u0639\u062f\u0627\u062f \u0635\u0646\u062f\u0644\u06cc \u0627\u06cc\u0646 \u0645\u06cc\u0632 4\u00a0 \u0639\u062f\u062f \u0628\u0648\u062f\u0647 \u0648 \u0641\u0642\u0637 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062f\u0631 \u062f\u0627\u062e\u0644 \u0645\u0646\u0632\u0644 \u062a\u0648\u0635\u06cc\u0647 \u0645\u06cc\u0634\u0648\u062f.\r\n\r\n\u0627\u06cc\u0646 \u0645\u062d\u0635\u0648\u0644 \u0642\u0627\u0628\u0644\u06cc\u062a \u062c\u062f\u0627\u06a9\u0631\u062f\u0646 \u0642\u0637\u0639\u0627\u062a \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u062f\u0627\u0634\u062a\u0647 \u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0622\u0646 \u0628\u0647 \u0628\u0647\u06cc\u0646\u0647 \u0633\u0627\u0632\u06cc \u0627\u0646\u0631\u0698\u06cc \u0646\u06cc\u0632 \u06a9\u0645\u06a9 \u0645\u06cc\u06a9\u0646\u062f.\r\n\r\n\u0634\u0645\u0627 \u0645\u06cc\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062e\u0631\u0627\u0634 \u0633\u0637\u062d \u060c \u0628\u0627 \u0645\u062d\u0627\u0641\u0638 fixa \u0628\u0647 \u0635\u0648\u0631\u062a \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0628\u0647 \u0641\u0631\u0648\u0634 \u0645\u06cc\u0631\u0633\u062f\u060c \u062a\u06a9\u0645\u06cc\u0644 \u06a9\u0646\u06cc\u062f.\r\n\r\n<strong>\u0686\u0648\u0628 \u062c\u0627\u0645\u062f \u0686\u06cc\u0633\u062a\u061f<\/strong>\r\n\r\n\u0686\u0648\u0628 \u062c\u0627\u0645\u062f \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u0648\u0627\u062f \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647 \u0645\u0627 \u0627\u0633\u062a \u0648 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0645\u06cc\u0631\u0627\u062b \u0627\u0633\u06a9\u0627\u0646\u062f\u06cc\u0646\u0627\u0648\u06cc \u0645\u0627 \u0627\u0633\u062a. \u0647\u0645\u0686\u0646\u06cc\u0646 \u06cc\u06a9 \u0645\u0627\u062f\u0647 \u062c\u0627\u0648\u062f\u0627\u0646\u0647 \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u062f\u0647\u0627\u06cc \u0641\u0631\u0627\u0648\u0627\u0646 \u0627\u0633\u062a.\r\n\r\n\u0635\u0631\u0641 \u0646\u0638\u0631 \u0627\u0632 \u0646\u0648\u0639 \u0686\u0648\u0628\u060c \u0628\u0627\u062f\u0648\u0627\u0645\u060c \u0632\u06cc\u0628\u0627\u060c \u062a\u062c\u062f\u06cc\u062f \u067e\u0630\u06cc\u0631 \u0648 \u0642\u0627\u0628\u0644 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u0627\u0633\u062a. \u0645\u0627 \u062f\u0631 \u062a\u0644\u0627\u0634 \u0647\u0633\u062a\u06cc\u0645 \u062a\u0627 \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0627\u062f\u0647 \u062e\u0627\u0645 \u062a\u0627 \u062d\u062f \u0627\u0645\u06a9\u0627\u0646 \u0647\u0648\u0634\u0645\u0646\u062f\u0627\u0646\u0647 \u0648 \u06a9\u0627\u0631\u0622\u0645\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0627\u0632 \u0627\u062a\u0644\u0627\u0641 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u06a9\u0646\u06cc\u0645\r\n\r\n\u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u062f\u0631 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0648 \u062a\u062f\u0627\u0631\u06a9\u0627\u062a \u0633\u0631\u0645\u0627\u06cc\u0647 \u06af\u0630\u0627\u0631\u06cc \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0628\u062a\u0648\u0627\u0646\u06cc\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0686\u0648\u0628 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a\u06cc \u0631\u0627 \u0627\u0641\u0632\u0627\u06cc\u0634 \u062f\u0647\u06cc\u0645. \u0628\u0647 \u0627\u06cc\u0646 \u062a\u0631\u062a\u06cc\u0628\u060c \u0627\u0632 \u0647\u0631 \u062f\u0631\u062e\u062a\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0642\u062f\u0627\u0631 \u0627\u0646\u062f\u06a9 \u0628\u0647 \u062e\u0648\u0628\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f\r\n\r\n&nbsp;\r\n<h5>\u062c\u0646\u06af\u0644 \u0647\u0627 \u0628\u0631\u0627\u06cc \u062d\u06cc\u0627\u062a \u0631\u0648\u06cc \u0632\u0645\u06cc\u0646 \u062d\u06cc\u0627\u062a\u06cc \u0647\u0633\u062a\u0646\u062f<\/h5>\r\n\u062c\u0646\u06af\u0644 \u0647\u0627 \u0628\u0647 \u062d\u0641\u0638 \u062a\u0639\u0627\u062f\u0644 \u062f\u0631 \u062c\u0648 \u06a9\u0645\u06a9 \u0645\u06cc \u06a9\u0646\u0646\u062f\u060c \u0647\u0648\u0627\u06cc\u06cc \u06a9\u0647 \u062a\u0646\u0641\u0633 \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u0631\u0627 \u062a\u0635\u0641\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u0646\u062f \u0648 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0686\u0631\u062e\u0647 \u0622\u0628 \u0647\u0633\u062a\u0646\u062f.\r\n\r\n90 \u062f\u0631\u0635\u062f \u06af\u0648\u0646\u0647 \u0647\u0627\u06cc \u06af\u06cc\u0627\u0647\u06cc \u0648 \u062c\u0627\u0646\u0648\u0631\u06cc \u06a9\u0647 \u0631\u0648\u06cc \u06a9\u0631\u0647 \u0632\u0645\u06cc\u0646 \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc \u06a9\u0646\u0646\u062f \u0628\u0631\u0627\u06cc \u0628\u0642\u0627 \u0628\u0647 \u062c\u0646\u06af\u0644 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u0646\u062f.\r\n\r\n\u0622\u0646\u0647\u0627 \u0645\u0646\u0627\u0628\u0639 \u063a\u0630\u0627\u060c \u0633\u0648\u062e\u062a\u060c \u0627\u0644\u0648\u0627\u0631 \u0648 \u0628\u0633\u06cc\u0627\u0631\u06cc \u062f\u06cc\u06af\u0631 \u0627\u0632 \u062e\u062f\u0645\u0627\u062a \u0627\u06a9\u0648\u0633\u06cc\u0633\u062a\u0645\u06cc \u0631\u0627 \u06a9\u0647 \u0645\u0627 \u0628\u0647 \u0622\u0646\u0647\u0627 \u062a\u06a9\u06cc\u0647 \u0645\u06cc \u06a9\u0646\u06cc\u0645\u060c \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc \u06a9\u0646\u0646\u062f.\r\n\r\nIKEA \u0628\u0627 \u062a\u0623\u0645\u06cc\u0646 \u062d\u062f\u0648\u062f 19 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0645\u062a\u0631\u0645\u06a9\u0639\u0628 \u0686\u0648\u0628 \u06af\u0631\u062f \u062f\u0631 \u0633\u0627\u0644 \u0627\u0632 50 \u06a9\u0634\u0648\u0631 \u062c\u0647\u0627\u0646\u060c \u062a\u0623\u062b\u06cc\u0631 \u0642\u0627\u0628\u0644 \u062a\u0648\u062c\u0647\u06cc \u0628\u0631 \u062c\u0646\u06af\u0644\u200c\u0647\u0627\u06cc \u062c\u0647\u0627\u0646 \u0648 \u0635\u0646\u0639\u062a \u0686\u0648\u0628 \u062f\u0627\u0631\u062f \u0648\r\n\r\n\u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0628\u0632\u0631\u06af\u06cc \u0628\u0631\u0627\u06cc \u062a\u0623\u062b\u06cc\u0631 \u0645\u062b\u0628\u062a \u0628\u0631 \u0646\u062d\u0648\u0647 \u062a\u0623\u0645\u06cc\u0646 \u0686\u0648\u0628 \u062f\u0627\u0631\u062f. \u062a\u0627\u0645\u06cc\u0646 \u0645\u0646\u0627\u0628\u0639 \u0686\u0648\u0628 \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u062c\u0646\u06af\u0644 \u0645\u0633\u0626\u0648\u0644\u0627\u0646\u0647 \u062a\u0636\u0645\u06cc\u0646 \u0645\u06cc \u06a9\u0646\u062f","short_description":"\u0645\u06cc\u0632 \u06af\u0631\u062f \u0627\u06cc\u06a9\u06cc\u0627 GAMLARED\u00a0 \u0645\u06cc\u0632 \u06af\u0631\u062f<strong> \u0627\u06cc\u06a9\u06cc\u0627<\/strong> \u0645\u06cc\u0632 \u0645\u0646\u0627\u0633\u0628\u06cc \u0628\u0631\u0627\u06cc \u062f\u0648\u0631\u0647\u0645\u06cc \u0648 \u0645\u0639\u0627\u0634\u0631\u062a \u0628\u0648\u062f\u0647 \u00a0\u0648 \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u06af\u0641\u062a\u06af\u0648\u06cc\u06cc \u0622\u0631\u0627\u0645 \u062f\u0639\u0648\u062a \u0645\u06cc \u06a9\u0646\u062f.\r\n\r\n\u062d\u0633 \u06af\u0631\u0645\u0627\u06cc \u0686\u0648\u0628 \u0628\u0627 \u0644\u0628\u0647 \u0647\u0627\u06cc \u0646\u0631\u0645 \u0648 \u0645\u0646\u062d\u0646\u06cc \u0641\u0636\u0627\u06cc\u06cc \u062f\u0646\u062c \u0648 \u0622\u0631\u0627\u0645 \u0631\u0627 \u0627\u06cc\u062c\u0627\u062f \u0645\u06cc \u06a9\u0646\u062f \u0648 \u00a0\u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u062f\u0631 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u062e\u062