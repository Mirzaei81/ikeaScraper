{"url":"https://zardaan.com/wp-json/wc/v3/set_draft","status":412,"headers":{"cf-cache-status":"DYNAMIC","cf-ray":"a3e0e4e4c9f74248-BOM","content-type":"text/html; charset=utf-8","date":"Sun, 20 Sep 2026 12:39:39 GMT","server":"cloudflare","wcdn-edge":"10.42.1.4","wcdn-edge-id":"13265151","wcdn-rayid":"W13265151T1789907978Y27668"},"body":"<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"https://zardaan.com/favicon.png\">\n    <link rel=\"icon\" href=\"https://zardaan.com/favicon.png\">\n    <title>Error - Precondition Failed</title>\n    <script>\n        function copyRayID() {\n            var copyText = document.getElementById(\"ray-id-input\");\n\n            copyText.select();\n            copyText.setSelectionRange(0, 99999);\n\n            navigator.clipboard.writeText(copyText.value);\n\n            document.getElementById('check-icon').style.display = 'block';\n            document.getElementById('copy-icon').style.display = 'none';\n\n            setTimeout(() => {\n                document.getElementById('check-icon').style.display = 'none';\n                document.getElementById('copy-icon').style.display = 'block';\n            }, 2000);\n        }\n\n        function updateTime() {\n            const now = new Date();\n            const hours = String(now.getHours()).padStart(2, '0');\n            const minutes = String(now.getMinutes()).padStart(2, '0');\n            const seconds = String(now.getSeconds()).padStart(2, '0');\n            const fullDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n\n            const tzHour = Math.floor(Math.abs(now.getTimezoneOffset()) / 60);\n            const tzMinute = Math.abs(now.getTimezoneOffset()) % 60;\n            const tzSign = now.getTimezoneOffset() > 0 ? '-' : '+';\n            const tzString = `${tzSign}${tzHour}:${String(tzMinute).padStart(2, '0')}`;\n            const formattedTime = `${hours}:${minutes}:${seconds}`;\n            document.getElementById('time').textContent = `${fullDate} ${formattedTime} UTC${tzString}`;\n        }\n        function checkCountryValue() {\n            var textSpan = document.getElementById('country-span');\n            var countrySeperator = document.getElementById('country-seperator');\n            var countryDiv = document.getElementById('country-div');\n\n            // Check if the text inside the span is empty\n            if (!textSpan.textContent.trim()) {\n                // If the span is empty, hide the content block\n                countrySeperator.style.display = 'none';\n                countryDiv.style.display = 'none';\n            }\n        }\n    </script>\n\n    <style>\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: bold;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-SemiBold.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: 100;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-Regular.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: 300;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-Regular.ttf') format('truetype');\n\n        }\n\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: normal;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-Regular.ttf') format('truetype');\n\n        }\n\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: 500;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-Medium.ttf') format('truetype');\n\n        }\n\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: 800;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-Bold.ttf') format('truetype');\n\n        }\n\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: 900;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-ExtraBold.ttf') format('truetype');\n\n        }\n\n        @font-face {\n            font-family: baloo2;\n            font-style: normal;\n            font-weight: 950;\n            src: url('https://parspack.com/fonts/baloo2/Baloo2-ExtraBold.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: bold;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebbold.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebbold.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanwebbold.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanwebbold.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: 100;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebthin.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebthin.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanwebthin.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanwebthin.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: 300;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanweblight.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanweblight.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanweblight.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanweblight.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: normal;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebregular.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebregular.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanwebregular.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanwebregular.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: 500;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebmedium.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebmedium.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanwebmedium.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanwebmedium.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: 800;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebextrabold.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebextrabold.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanwebextrabold.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanwebextrabold.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: 900;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebblack.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebblack.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanwebblack.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanwebblack.ttf') format('truetype');\n        }\n\n        @font-face {\n            font-family: iranyekan;\n            font-style: normal;\n            font-weight: 950;\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebextrablack.eot');\n            src: url('https://parspack.com/fonts/iran-yekan/eot/iranyekanwebextrablack.eot?#iefix') format('embedded-opentype'),\n                /* IE6-8 */\n                url('https://parspack.com/fonts/iran-yekan/woff/iranyekanwebextrablack.woff') format('woff'),\n                /* FF3.6+, IE9, Chrome6+, Saf5.1+*/\n                url('https://parspack.com/fonts/iran-yekan/ttf/iranyekanwebextrablack.ttf') format('truetype');\n        }\n\n        body {\n            font-family: baloo2;\n            background-color: #E9EDF6;\n            color: #55768B;\n            margin: 0;\n            padding: 20px;\n        }\n\n        .error-container {\n            margin: 0 auto;\n            background-color: #F5F8FE;\n            border-radius: 20px;\n            position: relative;\n            max-width: 1300px;\n            width: 100%;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            padding-top: 25px;\n            padding-bottom: 30px;\n            box-shadow: 0px 85px 19px -60px #358CCB08;\n        }\n\n        .error-background {\n            height: 220px;\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            z-index: 0;\n        }\n\n        .error-title {\n            font-size: 25px;\n            font-weight: 500;\n            line-height: 30px;\n            text-align: center;\n            margin: 0;\n            margin-bottom: 10px;\n            z-index: 1;\n        }\n\n        .error-description {\n            font-size: 14px;\n            font-weight: 400;\n            line-height: 25px;\n            text-align: center;\n            margin-left: 20px;\n            margin-right: 20px;\n            z-index: 1;\n        }\n\n        .error-code {\n            font-family: iranyekan;\n            font-size: 105px;\n            font-weight: 900;\n            line-height: 180px;\n            z-index: 1;\n        }\n\n        .ray-id {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            margin-bottom: 32px;\n            z-index: 1;\n        }\n\n        .ray-id-title {\n            font-size: 13px;\n            font-weight: 400;\n            line-height: 20px;\n            text-align: center;\n        }\n\n        .ray-id-value {\n            font-size: 16px;\n            font-weight: 500;\n            line-height: 25px;\n            display: flex;\n            align-items: center;\n            justify-items: center;\n            gap: 5px;\n\n            font-family: baloo2;\n\n            direction: ltr;\n        }\n\n        .ray-id-value svg {\n            cursor: pointer;\n        }\n\n        #ray-id-input {\n            display: none;\n        }\n\n        .footer-items {\n            display: flex;\n            justify-items: center;\n            align-items: center;\n            gap: 20px;\n            padding-right: 15px;\n            padding-left: 15px;\n            z-index: 1;\n        }\n\n        .footer-item {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n\n        .footer-item-title {\n            font-size: 10px;\n            font-weight: 400;\n            line-height: 16px;\n            text-align: center;\n        }\n\n        .footer-item-value {\n            font-size: 14px;\n            font-weight: 500;\n            line-height: 22px;\n            text-align: center;\n        }\n\n        .footer-item-separator {\n            content: ' ';\n            display: block;\n            width: 2px;\n            background-color: #55768B;\n            height: 23px;\n        }\n\n        @media (min-width: 640px) {\n            body {\n                padding: 60px;\n            }\n\n            .error-container {\n                padding-top: 65px;\n            }\n\n            .error-background {\n                width: 100%;\n                height: auto;\n            }\n\n            .error-title {\n                font-size: 50px;\n                font-weight: 500;\n                line-height: 30px;\n                margin-bottom: 30px;\n            }\n\n            .error-description {\n                font-size: 20px;\n                font-weight: 400;\n                line-height: 30px;\n                max-width: 550px;\n                margin: 0;\n            }\n\n            .error-code {\n                font-size: 250px;\n                font-weight: 900;\n                line-height: 430px;\n                margin-top: -30px;\n            }\n\n            .ray-id {\n                margin-top: -80px;\n            }\n\n            .ray-id-title {\n                font-size: 16px;\n                font-weight: 400;\n                line-height: 26px;\n            }\n\n            .ray-id-value {\n                font-size: 20px;\n                font-weight: 500;\n                line-height: 32px;\n            }\n\n            .footer-items {\n                gap: 30px;\n            }\n\n            .footer-item-title {\n                font-size: 12px;\n                font-weight: 400;\n                line-height: 20px;\n            }\n\n            .footer-item-value {\n                font-size: 16px;\n                font-weight: 500;\n                line-height: 25px;\n            }\n        }\n    </style>\n</head>\n\n<body>\n    <div class=\"error-container\">\n        <h1 class=\"error-title\" id=\"error-header\"><span>Error - Precondition Failed</span></h1>\n\n        <p class=\"error-description\" id=\"error-msg\">There&#x27;s a problem with the website&#x27;s configuration, or the URL is invalid</p>\n\n        <div class=\"error-code\" id=\"status-code\">412</div>\n\n        <div class=\"ray-id\">\n            <span class=\"ray-id-title\">Ray ID</span>\n            <div class=\"ray-id-value\">\n                <input id=\"ray-id-input\" type=\"input\" value=\"W13265151T1789907978Y27668\">\n                <span id=\"ray-id\">W13265151T1789907978Y27668</span>\n                <svg onclick=\"copyRayID()\" id=\"copy-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"\n                    xmlns=\"http://www.w3.org/2000/svg\">\n                    <path\n                        d=\"M6 11.9997C5.63333 11.9997 5.31944 11.8691 5.05833 11.608C4.79722 11.3469 4.66667 11.033 4.66667 10.6663V2.66634C4.66667 2.29967 4.79722 1.98579 5.05833 1.72467C